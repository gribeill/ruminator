{
  "name": "ruminator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#ui-text-source": {
      "workerd": "./src/hosted/ui-text-source.ts",
      "default": "./src/ui-text-source.ts"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/cli.ts start",
    "generate": "node src/cli.ts generate",
    "fetch": "node src/cli.ts fetch",
    "serve": "node src/cli.ts serve",
    "dev:hosted": "node scripts/hosted-preview.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project src/hosted/tsconfig.json",
    "score": "node src/cli.ts score",
    "text": "node src/cli.ts text",
    "summarize": "node src/cli.ts summarize",
    "test:model": "node --test test/model.integration.ts"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@huggingface/transformers": "4.3.2",
    "fast-xml-parser": "^5.0.0",
    "gpt-tokenizer": "^4.1.1",
    "jose": "6.2.17",
    "katex": "^0.19.1",
    "linkedom": "^0.18.15",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "wrangler": "4.160.0"
  }
}
