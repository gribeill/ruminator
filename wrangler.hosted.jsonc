{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local auth slice only. Configure real D1, Access, and the custom domain together before deploying.
  "name": "ruminator",
  "main": "src/hosted/worker.ts",
  "rules": [{ "type": "Text", "globs": ["**/ui_text.toml"], "fallthrough": true }],
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "ip": "127.0.0.1" },
  "vars": {
    "HOSTED_EXECUTION_ENABLED": "false",
    "HOSTED_SCHEDULE_ENABLED": "false",
    "PUBLIC_ORIGIN": "http://127.0.0.1:8787",
    "ACCESS_ISSUER": "http://127.0.0.1:8788",
    "ACCESS_AUDIENCE": "ruminator-local-fixture"
  },
  "assets": { "directory": ".wrangler/hosted-assets", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{
    "binding": "DB", "database_name": "ruminator-local-auth",
    "database_id": "00000000-0000-0000-0000-000000000000", "remote": false
  }]
}
